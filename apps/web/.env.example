# Copy to .env.local (never commit real values). Only VITE_* variables reach the browser,
# so nothing secret belongs here: the SPA is a public OIDC client (authorization code + PKCE).

# Base URL of the CIMS_NextMCC API. Leave empty to call the same origin (behind the gateway,
# or through the dev proxy below).
VITE_API_BASE_URL=http://localhost:5000

# CIMS Identity Server authority (issuer URL).
VITE_IDENTITY_AUTHORITY=https://identity.example.invalid

# OIDC client id registered in Identity for this SPA. Defaults to cims-nextmcc-spa when unset.
VITE_CLIENT_ID=cims-nextmcc-spa

# Dev server only, not exposed to the browser: forward /api to a local API so that the browser sees a
# single origin like it does behind the gateway. Use with an empty VITE_API_BASE_URL.
# DEV_API_PROXY_TARGET=http://localhost:5000

# `vite dev` only (ignored by production builds): a bearer token minted with
#   dotnet user-jwts create --project src/CIMSNextMCC.API --scheme DevJwt --name <PwInfo user> \
#     --audience cims-nextmcc-api --scope cims.nextmcc --claim "username=<PwInfo user>" --claim tenant=NextMCC
# signs the SPA in without CIMS Identity. Alternatively paste it on the sign-in page ("Use dev token").
# Local only: it is a credential for your local API, so keep it in .env.local, never in this file.
# VITE_DEV_BEARER_TOKEN=
